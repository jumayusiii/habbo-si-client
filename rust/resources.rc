#include <windows.h>

1 ICON "../assets/habbo.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,2,0,4
 PRODUCTVERSION 1,2,0,4
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jumayusi"
            VALUE "FileDescription", "Habbo.si Client Beta (Rust)"
            VALUE "FileVersion", "1.2.0.4"
            VALUE "InternalName", "habbo-si-client-rust"
            VALUE "LegalCopyright", "Copyright (C) 2026 Jumayusi"
            VALUE "OriginalFilename", "Habbo.si Client Beta (Rust).exe"
            VALUE "ProductName", "Habbo.si Client Beta"
            VALUE "ProductVersion", "1.2.0-beta.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
